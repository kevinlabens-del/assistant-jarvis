{
  "expo": {
    "name": "CR3@TIX-JARVIS",
    "slug": "cr3atix-jarvis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "web"],
    "android": {
      "package": "com.cr3atix.jarvis",
      "permissions": ["RECORD_AUDIO", "VIBRATE"]
    },
    "web": {
